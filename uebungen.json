   "id": "3",
   "name": "Hüftbeuger-Dehnung im Kniestand",
   "kategorie": "Hüfte",
   "text": "Ausfallschritt, hinteres Knie auf dem Boden\nOberkörper aufrecht, Hände an die Hüfte\nBecken langsam nach vorne unten schieben\n3 × 30 Sekunden pro Seite halten",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  },
  {
   "id": "4",
   "name": "Brücke (Bridging)",
   "kategorie": "Rücken",
   "text": "Rückenlage, Füße hüftbreit aufstellen\nBecken anheben, bis Oberschenkel und Rumpf eine Linie bilden\nOben 3 Sekunden halten, Po anspannen\n3 × 10 Wiederholungen",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  },
  {
   "id": "5",
   "name": "Katze – Kuh",
   "kategorie": "Rücken",
   "text": "Vierfüßlerstand, Hände unter den Schultern\nRücken langsam rund machen, Kinn zur Brust\nDann ins leichte Hohlkreuz, Blick nach vorne\n2 × 10 langsame Wiederholungen",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  },
  {
   "id": "6",
   "name": "Vogel-Hund (Bird Dog)",
   "kategorie": "Rücken",
   "text": "Vierfüßlerstand, Bauch leicht anspannen\nRechten Arm und linkes Bein gleichzeitig strecken\nBecken bleibt ruhig, kein Hohlkreuz\n3 × 8 Wiederholungen pro Seite, je 3 Sekunden halten",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  },
  {
   "id": "7",
   "name": "Unterarmstütz (Plank)",
   "kategorie": "Rücken",
   "text": "Ellenbogen unter den Schultern aufstützen\nKörper bildet eine gerade Linie\nBauch und Po fest anspannen, nicht durchhängen\n3 × 20–30 Sekunden halten",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  },
  {
   "id": "8",
   "name": "Außenrotation mit Band",
   "kategorie": "Schulter",
   "text": "Ellenbogen 90° gebeugt, fest am Körper\nBand mit dem Unterarm nach außen ziehen\nSchulter bleibt tief, kein Hochziehen\n3 × 15 Wiederholungen pro Seite",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  },
  {
   "id": "9",
   "name": "Seitheben",
   "kategorie": "Schulter",
   "text": "Aufrecht stehen, Arme hängen locker\nBeide Arme seitlich bis auf Schulterhöhe heben\nSchultern nicht zu den Ohren ziehen\n3 × 12 Wiederholungen, langsam absenken",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  },
  {
   "id": "10",
   "name": "Wandsitz",
   "kategorie": "Knie",
   "text": "Rücken an die Wand, Füße hüftbreit\nIn die Hocke rutschen bis ca. 90° Kniewinkel\nKnie bleiben über den Sprunggelenken\n3 × 30 Sekunden halten",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  },
  {
   "id": "11",
   "name": "Kniebeuge",
   "kategorie": "Knie",
   "text": "Füße schulterbreit, Fußspitzen leicht nach außen\nPo nach hinten unten schieben wie beim Hinsetzen\nKnie zeigen in Richtung der Fußspitzen\n3 × 12 Wiederholungen",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  },
  {
   "id": "12",
   "name": "Einbeinstand",
   "kategorie": "Knie",
   "text": "Auf einem Bein stehen, Knie leicht gebeugt\nBecken gerade halten\nKnie zeigt über die zweite Zehe\n3 × 30 Sekunden pro Seite",
   "bilder": [
    "data:image/svg+xml;base64,",
    "data:image/svg+xml;base64,"
   ]
  }
 ]
